{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voxNest",
  "version": "0.8.15",
  "identifier": "com.voxnest.studio",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "node scripts/prebuild.js",
    "beforeBuildCommand": "node scripts/prebuild.js"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "backend",
      "bin",
      "python",
      "zh_CN.lproj",
      "en.lproj"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}